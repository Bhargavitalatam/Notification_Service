# Notification Service Environment Variables

# Apache Kafka Broker Address
# For Docker Compose: kafka:29092
# For Local Development: localhost:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Target User Profile Service Endpoint URL
# For Docker Compose: http://notification-service:8080/mock-users
# For Local Development: http://localhost:8080/mock-users
USER_PROFILE_SERVICE_URL=http://notification-service:8080/mock-users

# Server HTTP Port
SERVER_PORT=8080
