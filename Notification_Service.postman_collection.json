{
	"info": {
		"_postman_id": "8c59f234-91da-4547-b892-748df3a3cb8e",
		"name": "Notification Service API & Resilience Suite",
		"description": "Comprehensive Postman collection for testing the Event-Driven Notification Service, Kafka Messaging, and Resilience4j Circuit Breaker transitions.",
